# ==============================================================================
# .gitignore — Gradient Learnings Data Analytics Hackathon 2026 (Olist)
# ==============================================================================

# Python Bytecode & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Testing, Coverage & Type Checking
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*-checkpoint.ipynb

# IDEs & Code Editors
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.history/
.cursor/
.cursorrules

# AI Agent Tooling & Metadata Roots
.agents/
.claude/
.factory/
.junie/
.kiro/
.pi/
.qoder/
.windsurf/
.gemini/
.antigravity/

# Large Datasets & Storage (Do not push gigabytes of CSV/Parquet to git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/interim/*
!data/interim/.gitkeep
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.tar.gz
*.gz
*.rar
*.7z

# Large / Generated Output Media (Preserve markdown reports & summary tables in git)
outputs/figures/*.png
outputs/figures/*.jpg
outputs/figures/*.jpeg
outputs/figures/*.svg
outputs/figures/*.html
outputs/figures/*.pdf
outputs/tables/*.parquet
outputs/tables/*.feather

# Temporary, Logs & Scratch
*.log
*.tmp
*.temp
scratch/*
!scratch/.gitkeep

# OS-Specific Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
